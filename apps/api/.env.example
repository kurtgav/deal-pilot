# NVIDIA NIM
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_MODEL=meta/llama-3.3-70b-instruct

# Retrieval embeddings: 'tfidf' (default, offline) or 'hosted' (NVIDIA NIM
# semantic embeddings). 'hosted' needs NVIDIA_NIM_API_KEY and a re-tuned
# grounding threshold — see the eval A/B before switching.
EMBEDDING_PROVIDER=tfidf
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Demo mode — canned deterministic LLM; runs a full call with ZERO external AI
# keys (NVIDIA not required). STT/TTS already fall back to the browser.
DEMO_MODE=false

# Agora RTC
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Voice
DEEPGRAM_API_KEY=xxx
ELEVENLABS_API_KEY=xxx

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# PII & retention (Golden Rule #4)
TRANSCRIPT_TTL_HOURS=24   # hours an ended session's transcript is kept before purge
PII_REDACTION=false       # true = mask emails/phones in transcripts at write time

# Supabase (server-only; service role bypasses RLS — keep secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
